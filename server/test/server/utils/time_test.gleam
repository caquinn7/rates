import gleam/list
import server/utils/time

pub fn parse_provider_timestamps_test() {
  [
    #("2026-11-08T13:53:03.000Z", 1_794_145_983_000),
    #("2026-11-08T13:56:00.550875Z", 1_794_146_160_550),
    #("2026-11-08T13:56:00Z", 1_794_146_160_000),
    #("2026-11-08 13:56:00Z", 1_794_146_160_000),
    #("2026-11-08T13:56:60Z", 1_794_146_220_000),
    #("2026-11-08T13:56:60.550875+05:30", 1_794_126_420_550),
    #("2026-11-08T13:56:00.5Z", 1_794_146_160_500),
    #("2026-11-08T13:56:00.55Z", 1_794_146_160_550),
    #("2026-11-08T13:56:00.550Z", 1_794_146_160_550),
    #("2026-11-08T13:56:00.999999999Z", 1_794_146_160_999),
    #("2026-11-08T13:56:00.999999999999Z", 1_794_146_160_999),
    #("2026-11-08T13:56:00.000999999Z", 1_794_146_160_000),
    #("2026-11-08T07:56:00.550875-06:00", 1_794_146_160_550),
    #("2026-11-08T19:26:00.550875+05:30", 1_794_146_160_550),
    #("2026-11-08t13:56:00.550875z", 1_794_146_160_550),
    #("1970-01-01T00:00:00Z", 0),
    #("1969-12-31T23:59:59.999999Z", -1),
    #("1969-12-31T23:59:59.000000001Z", -1000),
    #("2024-02-29T00:00:00Z", 1_709_164_800_000),
  ]
  |> list.each(fn(test_case) {
    let #(timestamp, expected) = test_case
    assert time.parse_rfc3339_ms(timestamp) == Ok(expected)
  })
}

pub fn reject_invalid_provider_timestamps_without_raising_test() {
  [
    "",
    "invalid",
    "2026-11-08",
    "2026-11-08T13:56:00",
    "2026-11-08T13:56:00Z\n",
    "2026-11-08T13:56:00.Z",
    "2026-11-08T13:56:00.invalidZ",
    "2026-11-08T13:56:00Zextra",
    "2026-02-29T13:56:00Z",
    "2026-02-30T13:56:00Z",
    "2026-00-08T13:56:00Z",
    "2026-13-08T13:56:00Z",
    "2026-11-00T13:56:00Z",
    "2026-11-31T13:56:00Z",
    "2026-11-08T24:00:00Z",
    "2026-11-08T13:60:00Z",
    "2026-11-08T13:56:61Z",
    "2026-11-08T13:56:00+24:00",
    "2026-11-08T13:56:00-06:60",
    "2026-11-08T13:56:00+06",
  ]
  |> list.each(fn(timestamp) {
    assert time.parse_rfc3339_ms(timestamp) == Error(Nil)
  })
}
